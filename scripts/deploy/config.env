# 服务器地址：175.178.198.182  root
# 用途：把仓库部署到 /srv/base，用 pm2 常驻，nginx 80 反代
#
# 用法：
#   scripts/deploy/setup.sh         首次初始化（装依赖、建库、初始化 pm2）
#   scripts/deploy/deploy.sh        日常发布（拉代码、装依赖、构建、重载）
#
# 前置：本机已配置免密登录（见 scripts/deploy/setup.sh 顶部说明）。

HOST=root@175.178.198.182
APP_DIR=/srv/base
# 部署专用免密私钥（服务器上是 git checkout，代码由 git pull 获取）
SSH_KEY=~/.ssh/base_deploy_ed25519
BRANCH=feature/practice-coach

# 服务端口（仅监听 127.0.0.1，外部只能通过 nginx 80 访问）
API_PORT=3100
CLIENT_PORT=3101

# 对外访问地址（nginx 80）
PUBLIC_URL=http://175.178.198.182
