# PostgreSQL connection string used by Drizzle ORM and the Postgres pool.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app"

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS="http://localhost:5173,http://localhost:3001"

# API server port.
PORT=3000

# LLM — Anthropic Messages 协议兼容端点，SDK 会自动在 baseURL 后拼 /messages。
ANTHROPIC_API_KEY="sk-xxx"
ANTHROPIC_BASE_URL="https://aigateway.example.com/anthropic/v1"
ANTHROPIC_MODEL="deepseek-v4-flash"
