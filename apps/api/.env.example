# PostgreSQL connection string used by Drizzle ORM and the Postgres pool.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app"

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS="http://localhost:5173,http://localhost:3001"

# API server port.
PORT=3000

# LLM — Anthropic Messages 协议兼容端点，SDK 会自动在 baseURL 后拼 /messages。
ANTHROPIC_API_KEY="sk-xxx"
ANTHROPIC_BASE_URL="https://aigateway.example.com/anthropic/v1"
ANTHROPIC_MODEL="deepseek-v4-flash"

# 文件工具工作区根目录（相对路径都基于它解析），默认 <项目根>/workspace。
# TOOL_WORKSPACE_DIR="./workspace"

# 文件工具工作区守卫：false 时关闭路径越界检查，模型可访问服务器任意路径（仅限本地开发）。
# TOOL_WORKSPACE_GUARD="true"

# 执行权限：可切换全局角色（owner / collaborator / guest）的管理员邮箱，逗号分隔。
# 未配置时不限制（任何登录用户都能切）；对外部署必须配置。
# ADMIN_EMAILS="admin@example.com"

# 联网搜索工具（web_search）：二选一，优先使用 Tavily（含 AI 摘要）。
# TAVILY_API_KEY="tvly-xxx"
# SERPER_API_KEY="xxx"

# RAG 向量化：DashScope qwen3.7-text-embedding-flash（必填，缺失时 API 启动报错）。
DASHSCOPE_API_KEY="sk-xxx"

# MCP 外部工具：JSON 数组，每项为一个 stdio MCP server 的启动配置。
# 工具注册名格式为 mcp__<name>__<tool>，连接失败只跳过该 server 不影响对话。
# 示例（GitHub MCP server）：
# MCP_SERVERS='[{"name":"github","command":"npx","args":["-y","@modelcontextprotocol/server-github"],"env":{"GITHUB_PERSONAL_ACCESS_TOKEN":"ghp-xxx"}}]'

# 飞书 Bot（长连接模式）：在飞书开放平台创建应用后获取，需订阅 im.message.receive_v1 事件。
# 不配置时通道仍会注册，但不会建立连接。
# FEISHU_APP_ID="cli_xxx"
# FEISHU_APP_SECRET="xxx"

# Discord Bot（Gateway 长连接）：在 Discord Developer Portal 创建应用后获取，
# 需打开 MESSAGE CONTENT INTENT，否则收到的消息内容为空。
# DISCORD_BOT_TOKEN="xxx"
# 国内网络需要代理；Node 不读取系统代理，留空表示直连。
# DISCORD_PROXY_URL="http://127.0.0.1:7890"
# 主动推送目标频道（定时任务结果、notify_discord 工具共用）；留空则禁用推送。
# 频道 ID 在 Discord 客户端右键频道 → 复制频道 ID（需先开启设置中的开发者模式）。
# DISCORD_NOTIFY_CHANNEL_ID="123456789012345678"
# 每条主动推送都要 @ 的用户 ID；留空则不 @。
# DISCORD_NOTIFY_USER_ID="123456789012345678"

# Langfuse 可观测性：key 仍放 .env，super-agent.config.json 的 observability 段引用这些占位符
# （未生成配置文件时 schema 默认值同样回落到这几个环境变量；observability.enabled 可整体关闭）
# 区域：Japan https://jp.cloud.langfuse.com / EU https://cloud.langfuse.com / US https://us.cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY="pk-lf-xxx"
# LANGFUSE_SECRET_KEY="sk-lf-xxx"
# LANGFUSE_BASE_URL="https://jp.cloud.langfuse.com"

# 配置系统：apps/api/super-agent.config.json（可选，运行 pnpm --filter api config:init 生成）。
# 上述所有配置项（数据库、鉴权、端口/CORS、模型、工作区/搜索/MCP、RAG、飞书等）都可以在配置文件中覆盖：
#   database.url / auth.secret / auth.baseURL / server.port / server.corsOrigins
#   model.* / tools.* / rag.apiKey / channels.feishu.* / agents.* / security.* / cron.enabled / usage.trackingFile
# 敏感信息仍建议用 ${ENV_VAR} 引用本文件的变量。
# 配置文件不存在时全部使用默认值（即只认本文件），行为与改造前一致。

